# =======================================================================
#  Oral exam simulation - configuration
#  Copy this file to .env and fill in the values.
# =======================================================================

# --- Text generation backend (KI:connect, OpenAI compatible) -----------
# Greeting, generated questions, feedback and goodbye all go through this.
BASE_URL=https://chat.kiconnect.nrw/api/v1
API_KEY=
MODEL=Mistral-small-4-119b-2603

# Request timeout in seconds and how often a failed request is retried
LLM_TIMEOUT=120
LLM_RETRIES=3

# Set to true to answer from a canned string, for working on the page itself
DISABLE_LLM=false

# --- The examiner's voice ----------------------------------------------
# piper    the server renders the voice with a German speech model. Sounds the
#          same for everyone, about ten times faster than real time on CPU.
# browser  the page speaks the text itself with whatever voice the viewer's
#          operating system provides, which often reads German poorly.
TTS_ENGINE=piper

# German voices, in rising quality and size:
#   de_DE-thorsten-low (63 MB), -medium (63 MB), -high (114 MB)
#   de_DE-kerstin-low, de_DE-eva_k-x_low, de_DE-mls-medium,
#   de_DE-thorsten_emotional-medium
PIPER_VOICE=de_DE-thorsten-high

# --- Paraphrasing for hints --------------------------------------------
# local      runs the fine-tuned model of the paper
#            (LunaticTanuki/oop-de-qg-flan-t5-base-v6, about 1 GB)
# kiconnect  asks the text generation backend above instead
PARAPHRASE_ENGINE=local

# --- Courses -----------------------------------------------------------
# Content lives in courses/<id>/, each with a manifest.yaml. Every course that
# loads is offered; this one is preselected.
DEFAULT_COURSE=oop
# true refuses to start when any course manifest is broken. The default skips
# the broken course and serves the rest.
COURSE_STRICT=false

# --- Exam sessions -----------------------------------------------------
# Each session holds its own conversation; the models are shared. Two keeps
# the CPU load predictable.
MAX_SESSIONS=2
# Seconds to wait for an answer before it counts as silence
ANSWER_TIMEOUT=120
# Seconds a long-poll waits; must stay below the gunicorn timeout
POLL_TIMEOUT=25
# Seconds after which a session nobody polls any more is dropped
SESSION_IDLE_TIMEOUT=600

LOG_LEVEL=INFO
